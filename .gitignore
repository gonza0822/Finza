# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production / desktop installers
/build
/dist
/dist/desktop
electron/app-config.json
*.exe
*.apk
*.aab
*.idsig
*.dmg
*.AppImage

# env — keep .env.example and .env.aiven.example tracked
.env
.env.*
!.env.example
!.env.aiven.example

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# tests / browser automation
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.playwright-cli/
playwright-report/
playwright/.auth/
**/auth.json

# dumps and local DB files
*.sql
*.dump
*.sqlite
*.sqlite3

# vercel
.vercel

# Capacitor / Android / iOS build junk (the projects themselves stay tracked)
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/captures/
ios/App/Pods/
ios/App/build/

# typescript
*.tsbuildinfo
next-env.d.ts

# os / editor junk
.DS_Store
Thumbs.db
*.pem
.idea/

# local scratch (not product)
/notes/
/*.png

# Cursor (not required to run the app)
.cursor/
