{
  "name": "finza",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:aiven": "node scripts/db-aiven.cjs",
    "electron:dev": "electron .",
    "electron:build": "node scripts/write-electron-config.mjs && electron-builder --win nsis",
    "cap:sync": "node scripts/prepare-capacitor-config.mjs && cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@auth/sequelize-adapter": "^2.11.3",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-table": "^9.2.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.43.0",
    "mysql2": "^3.24.4",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "pg-hstore": "^2.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "sequelize": "^6.37.8",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/cli": "^0.1.19",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "sequelize-cli": "^6.6.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "app.finza.desktop",
    "productName": "Finza",
    "copyright": "Copyright © Finza",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "electron/**/*"
    ],
    "win": {
      "icon": "public/brand/logo-finza.png",
      "target": [
        "nsis"
      ],
      "artifactName": "Finza-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
